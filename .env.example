# Wedrink Environment Configuration

# Server Port
PORT=8080

# Environment (development | production)
ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/wedrink?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=wedrink

# Session Secret Key
SESSION_SECRET=wedrink-secret-key-change-in-production-2026

# Auto-seed default demo users on startup (admin/adminpassword, staff/staffpassword)
# Set to "true" to enable. Defaults to "false" in production.
AUTO_SEED=false
